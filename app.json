{
  "expo": {
    "name": "FashionTally",
    "slug": "fashiontally-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/fashionTally_logo.png",
    "scheme": "fashiontally",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fashion.fashiontally"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/brand/fashionTally_logo.png",
        "backgroundImage": "./assets/brand/fashionTally_logo.png",
        "monochromeImage": "./assets/brand/fashionTally_logo.png"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.fashion.fashiontally",
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/fashionTally_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "calendarPermission": "The app needs to access your calendar."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "c5e00ccb-6493-4488-810e-3f01600140bb"
      },
      "router": {}
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c5e00ccb-6493-4488-810e-3f01600140bb"
    }
  }
}
