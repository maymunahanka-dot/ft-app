{
  "cli": {
    "version": ">= 16.20.4",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME": "dhofmpabv",
        "EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET": "fashion-tally-unsigned",
        "EXPO_PUBLIC_CLOUDINARY_FOLDER": "img",
        "EXPO_PUBLIC_API_BASE_URL": "https://backend.fashiontally.com/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME": "dhofmpabv",
        "EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET": "fashion-tally-unsigned",
        "EXPO_PUBLIC_CLOUDINARY_FOLDER": "img",
        "EXPO_PUBLIC_API_BASE_URL": "https://backend.fashiontally.com/api"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6769135696"
      }
    }
  }
}
